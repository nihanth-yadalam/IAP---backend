# Database (PostgreSQL async)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/iap_db

# Security
SECRET_KEY=change_this_secret_key_to_something_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Redirect URI for the existing "Connect Google Calendar" flow (requires login first)
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Redirect URI for the "Sign in with Google" flow (public, no login required)
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/login/callback

# Webhooks (for production — must be HTTPS and publicly reachable)
WEBHOOK_BASE_URL=https://your-domain.com

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Frontend URL (for OAuth callback redirect)
FRONTEND_URL=http://localhost:5173
